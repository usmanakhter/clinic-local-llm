  "drug_count": 60,
  "drugs": [
    {"id": "drug_001", "generic_name": "Paracetamol", "generic_name_ne": "प्यारासिटामोल", "category": "Analgesic/Antipyretic", "nelm_tier": "core", "dosage_forms": ["tablet", "syrup", "suppository"], "strengths": ["500mg", "125mg/5ml", "250mg"], "brand_names": [{"name": "Nepalol", "manufacturer": "Nepal Pharmaceuticals"}, {"name": "Feverex", "manufacturer": "Deurali-Janta"}], "indications": ["Fever", "Mild to moderate pain"], "contraindications": ["Severe hepatic impairment"], "adult_dose": "500mg–1g q6h PRN; max 4g/day", "pediatric_dose": "15mg/kg q6h; max 60mg/kg/day", "pregnancy_category": "B", "rag_text": "Paracetamol (acetaminophen) first-line antipyretic and analgesic in Nepal OPD. Preferred over NSAIDs in pregnancy and peptic ulcer. Overdose >150mg/kg risks hepatotoxicity; N-acetylcysteine if within 8h."},
    {"id": "drug_002", "generic_name": "Ibuprofen", "generic_name_ne": "आइबुप्रोफेन", "category": "NSAID", "nelm_tier": "core", "dosage_forms": ["tablet", "suspension"], "strengths": ["400mg", "200mg", "100mg/5ml"], "brand_names": [{"name": "Brufen", "manufacturer": "Abbott"}, {"name": "Ibuflam", "manufacturer": "NPL"}], "indications": ["Pain", "Inflammation", "Fever"], "contraindications": ["Active GI bleed", "Third trimester pregnancy", "Severe renal impairment"], "adult_dose": "400mg q8h with food", "pediatric_dose": "5–10mg/kg q6–8h", "pregnancy_category": "C/D", "rag_text": "Ibuprofen NSAID for inflammatory pain. Avoid in dengue (bleeding risk). Use shortest duration. Monitor GI and renal function."},
    {"id": "drug_003", "generic_name": "Amoxicillin", "generic_name_ne": "अमोक्सिसिलिन", "category": "Antibiotic (penicillin)", "nelm_tier": "core", "dosage_forms": ["capsule", "suspension"], "strengths": ["500mg", "250mg", "125mg/5ml"], "brand_names": [{"name": "Mox", "manufacturer": "Nepal Remedies"}, {"name": "Amoxil", "manufacturer": "GSK"}], "indications": ["RTI", "UTI", "H. pylori", "Dental infection"], "contraindications": ["Penicillin allergy"], "adult_dose": "500mg TDS or 1g BD (high-dose)", "pediatric_dose": "25–50mg/kg/day divided q8h", "pregnancy_category": "B", "rag_text": "Amoxicillin first-line beta-lactam for community infections in Nepal. High resistance in typhoid — do not use alone for enteric fever. Check penicillin allergy history."},
    {"id": "drug_004", "generic_name": "Amoxicillin-Clavulanate", "generic_name_ne": "अमोक्सिसिलिन-क्लाभुलेनेट", "category": "Antibiotic", "nelm_tier": "core", "dosage_forms": ["tablet", "suspension"], "strengths": ["625mg", "457mg/5ml"], "brand_names": [{"name": "Augmentin", "manufacturer": "GSK"}, {"name": "Clavamox", "manufacturer": "NPL"}], "indications": ["Sinusitis", "Pneumonia", "Skin infection", "Animal bite"], "contraindications": ["Penicillin allergy", "Cholestatic jaundice with prior use"], "adult_dose": "625mg TDS", "pediatric_dose": "25mg amox/kg/day of amox component", "pregnancy_category": "B", "rag_text": "Co-amoxiclav for beta-lactamase producing organisms. First-line for cat/dog bites in Nepal. GI side effects common; take with food."},
    {"id": "drug_005", "generic_name": "Azithromycin", "generic_name_ne": "एजिथ्रोमाइसिन", "category": "Antibiotic (macrolide)", "nelm_tier": "core", "dosage_forms": ["tablet", "suspension"], "strengths": ["500mg", "250mg", "200mg/5ml"], "brand_names": [{"name": "Zithromax", "manufacturer": "Pfizer"}, {"name": "Azithral", "manufacturer": "Alembic"}], "indications": ["Atypical pneumonia", "Typhoid (alternative)", "Chlamydia", "Diarrhea (traveler's)"], "contraindications": ["Macrolide allergy", "QT prolongation with other QT drugs"], "adult_dose": "500mg OD x3 days or 1g single dose", "pediatric_dose": "10mg/kg OD x3 days", "pregnancy_category": "B", "rag_text": "Azithromycin useful for atypical pneumonia and as alternative in typhoid where fluoroquinolones contraindicated. QT prolongation risk — avoid with fluoroquinolones."},
    {"id": "drug_006", "generic_name": "Ciprofloxacin", "generic_name_ne": "सिप्रोफ्लोक्सासिन", "category": "Antibiotic (fluoroquinolone)", "nelm_tier": "complementary", "dosage_forms": ["tablet", "IV"], "strengths": ["500mg", "250mg"], "brand_names": [{"name": "Ciprodac", "manufacturer": "NPL"}, {"name": "Cipro", "manufacturer": "Bayer"}], "indications": ["Typhoid", "Complicated UTI", "GI infection"], "contraindications": ["Children <18 (routine)", "Pregnancy", "Tendinopathy history"], "adult_dose": "500mg BD x7–14 days (typhoid)", "pediatric_dose": "Avoid unless no alternative", "pregnancy_category": "C", "rag_text": "Ciprofloxacin historically used for typhoid in South Asia but rising resistance. Reserve for culture-guided therapy. Avoid in children and pregnancy."},
    {"id": "drug_007", "generic_name": "Ceftriaxone", "generic_name_ne": "सेफ्ट्रियाक्सोन", "category": "Antibiotic (cephalosporin)", "nelm_tier": "complementary", "dosage_forms": ["injection"], "strengths": ["1g", "500mg"], "brand_names": [{"name": "Monocef", "manufacturer": "Aristo"}, {"name": "Rocephin", "manufacturer": "Roche"}], "indications": ["Typhoid", "Meningitis", "Severe pneumonia", "Sepsis"], "contraindications": ["Neonates with calcium IV", "Cephalosporin allergy (severe)"], "adult_dose": "1–2g IV/IM OD", "pediatric_dose": "50–100mg/kg/day", "pregnancy_category": "B", "rag_text": "Ceftriaxone third-gen cephalosporin for severe infections and enteric fever. IM painful — use lidocaine diluent. Do not mix with calcium in neonates."},
    {"id": "drug_008", "generic_name": "Metronidazole", "generic_name_ne": "मेट्रोनिडाजोल", "category": "Antibiotic/Antiprotozoal", "nelm_tier": "core", "dosage_forms": ["tablet", "suspension", "IV"], "strengths": ["400mg", "200mg"], "brand_names": [{"name": "Flagyl", "manufacturer": "Sanofi"}, {"name": "Metrogyl", "manufacturer": "J.B. Chemicals"}], "indications": ["Amoebiasis", "Giardiasis", "Anaerobic infection", "H. pylori"], "contraindications": ["First trimester (relative)", "Active alcohol use"], "adult_dose": "400mg TDS x5–7 days", "pediatric_dose": "7.5mg/kg TDS", "pregnancy_category": "B", "rag_text": "Metronidazole for amoebic dysentery and giardiasis common in Nepal. Disulfiram-like reaction with alcohol. Metallic taste common."},
    {"id": "drug_009", "generic_name": "Albendazole", "generic_name_ne": "एल्बेन्डाजोल", "category": "Anthelmintic", "nelm_tier": "core", "dosage_forms": ["tablet", "suspension"], "strengths": ["400mg", "200mg"], "brand_names": [{"name": "Zentel", "manufacturer": "GSK"}, {"name": "Alben", "manufacturer": "NPL"}], "indications": ["Soil-transmitted helminths", "Neurocysticercosis"], "contraindications": ["Pregnancy (first trimester)", "Children <2 years (relative)"], "adult_dose": "400mg single dose (STH); 400mg BD x8–30 days (neurocysticercosis)", "pediatric_dose": "400mg single dose if >2 years", "pregnancy_category": "C", "rag_text": "Albendazole mass drug administration common in Nepal school programs. Single dose for roundworm, hookworm, whipworm."},
    {"id": "drug_010", "generic_name": "Ondansetron", "generic_name_ne": "ओन्डान्सेट्रोन", "category": "Antiemetic", "nelm_tier": "complementary", "dosage_forms": ["tablet", "IV", "ODT"], "strengths": ["4mg", "8mg"], "brand_names": [{"name": "Emeset", "manufacturer": "Cipla"}, {"name": "Zofran", "manufacturer": "GSK"}], "indications": ["Nausea/vomiting", "Chemotherapy-induced NV", "Gastroenteritis"], "contraindications": ["Congenital long QT"], "adult_dose": "4–8mg TDS PRN", "pediatric_dose": "0.15mg/kg q8h", "pregnancy_category": "B", "rag_text": "Ondansetron 5-HT3 antagonist for vomiting in gastroenteritis and pregnancy hyperemesis. Constipation common. Use lowest effective dose."},
    {"id": "drug_011", "generic_name": "Oral Rehydration Salts", "generic_name_ne": "ओआरएस", "category": "Rehydration", "nelm_tier": "core", "dosage_forms": ["powder"], "strengths": ["WHO formula sachet"], "brand_names": [{"name": "Jeevan Jal", "manufacturer": "Nepal Government"}, {"name": "Electral", "manufacturer": "FDC"}], "indications": ["Dehydration from diarrhea", "Cholera"], "contraindications": ["Ileus", "Shock without IV resuscitation"], "adult_dose": "200–400ml after each loose stool", "pediatric_dose": "50–100ml/kg over 4h (Plan B)", "pregnancy_category": "A", "rag_text": "ORS cornerstone of diarrhea management in Nepal. Low osmolarity WHO formula. Zinc co-therapy recommended for children."},
    {"id": "drug_012", "generic_name": "Zinc Sulfate", "generic_name_ne": "जिंक सल्फेट", "category": "Supplement", "nelm_tier": "core", "dosage_forms": ["tablet", "dispersible"], "strengths": ["20mg elemental", "10mg"], "brand_names": [{"name": "Zinconia", "manufacturer": "RPG"}, {"name": "Z&D", "manufacturer": "NPL"}], "indications": ["Acute diarrhea (children)", "Zinc deficiency"], "contraindications": ["None significant"], "adult_dose": "Not routine in adults for diarrhea", "pediatric_dose": "10mg (<6mo) or 20mg (>6mo) x10–14 days", "pregnancy_category": "A", "rag_text": "Zinc reduces diarrhea duration in Nepali children per WHO IMCI. Give with ORS for 10–14 days."},
    {"id": "drug_013", "generic_name": "Metformin", "generic_name_ne": "मेटफर्मिन", "category": "Antidiabetic", "nelm_tier": "core", "dosage_forms": ["tablet"], "strengths": ["500mg", "850mg", "1000mg"], "brand_names": [{"name": "Glycomet", "manufacturer": "USV"}, {"name": "Glucophage", "manufacturer": "Merck"}], "indications": ["Type 2 diabetes"], "contraindications": ["eGFR <30", "Acute metabolic acidosis", "Contrast dye (hold 48h)"], "adult_dose": "500mg BD titrate to 2g/day", "pediatric_dose": "Not first-line <10 years", "pregnancy_category": "B", "rag_text": "Metformin first-line T2DM in Nepal urban clinics. Hold before iodinated contrast. GI upset — start low, take with meals. B12 deficiency with long use."},
    {"id": "drug_014", "generic_name": "Glibenclamide", "generic_name_ne": "ग्लिबेन्क्लामाइड", "category": "Antidiabetic (sulfonylurea)", "nelm_tier": "core", "dosage_forms": ["tablet"], "strengths": ["5mg", "2.5mg"], "brand_names": [{"name": "Daonil", "manufacturer": "Sanofi"}, {"name": "Glynase", "manufacturer": "USV"}], "indications": ["Type 2 diabetes"], "contraindications": ["Type 1", "DKA", "Severe renal/hepatic impairment"], "adult_dose": "2.5–5mg OD before breakfast", "pediatric_dose": "Not recommended", "pregnancy_category": "C", "rag_text": "Glibenclamide cheap sulfonylurea common in rural Nepal. High hypoglycemia risk especially in elderly and renal impairment. Educate on hypoglycemia symptoms."},
    {"id": "drug_015", "generic_name": "Insulin Human (NPH)", "generic_name_ne": "इन्सुलिन एनपीएच", "category": "Antidiabetic", "nelm_tier": "complementary", "dosage_forms": ["injection"], "strengths": ["100 IU/ml"], "brand_names": [{"name": "Insulatard", "manufacturer": "Novo Nordisk"}, {"name": "Wosulin N", "manufacturer": "Wockhardt"}], "indications": ["Type 1 and Type 2 diabetes"], "contraindications": ["Hypoglycemia"], "adult_dose": "Individualized; typical 0.1–0.2 U/kg", "pediatric_dose": "Individualized", "pregnancy_category": "B", "rag_text": "NPH intermediate insulin. Cold chain challenge in Nepal hills — patient education on storage below 25°C. Rotate injection sites."},
    {"id": "drug_016", "generic_name": "Amlodipine", "generic_name_ne": "एम्लोडिपिन", "category": "Antihypertensive (CCB)", "nelm_tier": "core", "dosage_forms": ["tablet"], "strengths": ["5mg", "10mg", "2.5mg"], "brand_names": [{"name": "Amlong", "manufacturer": "Micro Labs"}, {"name": "Norvasc", "manufacturer": "Pfizer"}], "indications": ["Hypertension", "Angina"], "contraindications": ["Cardiogenic shock", "Severe aortic stenosis"], "adult_dose": "5mg OD; max 10mg", "pediatric_dose": "Not routine", "pregnancy_category": "C", "rag_text": "Amlodipine long-acting CCB first-line HTN in Nepal. Peripheral edema common. Once daily adherence friendly."},
    {"id": "drug_017", "generic_name": "Enalapril", "generic_name_ne": "एनालाप्रिल", "category": "Antihypertensive (ACE-I)", "nelm_tier": "core", "dosage_forms": ["tablet"], "strengths": ["5mg", "10mg", "2.5mg"], "brand_names": [{"name": "Enam", "manufacturer": "Dr. Reddy's"}, {"name": "Renitec", "manufacturer": "MSD"}], "indications": ["Hypertension", "Heart failure", "Diabetic nephropathy"], "contraindications": ["Pregnancy", "Bilateral renal artery stenosis", "Angioedema history"], "adult_dose": "5mg OD titrate to 10–20mg", "pediatric_dose": "0.08mg/kg OD", "pregnancy_category": "D", "rag_text": "Enalapril ACE inhibitor. Contraindicated in pregnancy — teratogenic. Monitor potassium and creatinine. Dry cough 10%."},
    {"id": "drug_018", "generic_name": "Losartan", "generic_name_ne": "लोसार्टान", "category": "Antihypertensive (ARB)", "nelm_tier": "complementary", "dosage_forms": ["tablet"], "strengths": ["50mg", "25mg", "100mg"], "brand_names": [{"name": "Losar", "manufacturer": "Unichem"}, {"name": "Cozaar", "manufacturer": "MSD"}], "indications": ["Hypertension", "Diabetic nephropathy"], "contraindications": ["Pregnancy", "Bilateral renal artery stenosis"], "adult_dose": "50mg OD; max 100mg", "pediatric_dose": "Not routine <6 years", "pregnancy_category": "D", "rag_text": "Losartan ARB alternative when ACE-I cough intolerable. Safer in pregnancy than ACE-I but still avoid in pregnancy."},
    {"id": "drug_019", "generic_name": "Atenolol", "generic_name_ne": "एटेनोलोल", "category": "Beta-blocker", "nelm_tier": "core", "dosage_forms": ["tablet"], "strengths": ["50mg", "25mg", "100mg"], "brand_names": [{"name": "Tenormin", "manufacturer": "AstraZeneca"}, {"name": "Betacard", "manufacturer": "NPL"}], "indications": ["Hypertension", "Angina", "Rate control in AF"], "contraindications": ["Asthma", "Bradycardia", "Decompensated HF"], "adult_dose": "50mg OD", "pediatric_dose": "Not routine", "pregnancy_category": "C", "rag_text": "Atenolol cardioselective beta-blocker. Avoid in asthma. Do not stop abruptly. Less preferred than amlodipine as first-line HTN."},
    {"id": "drug_020", "generic_name": "Furosemide", "generic_name_ne": "फुरोसेमाइड", "category": "Loop diuretic", "nelm_tier": "core", "dosage_forms": ["tablet", "IV"], "strengths": ["40mg", "20mg"], "brand_names": [{"name": "Lasix", "manufacturer": "Sanofi"}, {"name": "Frusemide", "manufacturer": "NPL"}], "indications": ["Edema", "Heart failure", "Acute pulmonary edema"], "contraindications": ["Anuria", "Severe hypokalemia"], "adult_dose": "40mg OD–BD oral; 20–40mg IV stat", "pediatric_dose": "1–2mg/kg", "pregnancy_category": "C", "rag_text": "Furosemide loop diuretic for fluid overload. Monitor K+, Mg2+, renal function. Take morning to avoid nocturia."},
    {"id": "drug_021", "generic_name": "Aspirin", "generic_name_ne": "एस्पिरिन", "category": "Antiplatelet/NSAID", "nelm_tier": "core", "dosage_forms": ["tablet"], "strengths": ["75mg", "300mg", "325mg"], "brand_names": [{"name": "Ecosprin", "manufacturer": "USV"}, {"name": "Disprin", "manufacturer": "Reckitt"}], "indications": ["ACS", "Secondary stroke prevention", "CVD prophylaxis"], "contraindications": ["Active bleeding", "Children with viral illness (Reye)", "Peptic ulcer"], "adult_dose": "75mg OD (cardioprotection); 300mg loading ACS", "pediatric_dose": "Avoid <16 years", "pregnancy_category": "C/D", "rag_text": "Low-dose aspirin antiplatelet. Avoid in dengue thrombocytopenia. GI bleed risk — consider PPI if high risk."},
    {"id": "drug_022", "generic_name": "Clopidogrel", "generic_name_ne": "क्लोपिडोग्रेल", "category": "Antiplatelet", "nelm_tier": "complementary", "dosage_forms": ["tablet"], "strengths": ["75mg", "300mg"], "brand_names": [{"name": "Plavix", "manufacturer": "Sanofi"}, {"name": "Clopilet", "manufacturer": "Sun Pharma"}], "indications": ["ACS", "Post-PCI", "Stroke/TIA"], "contraindications": ["Active bleeding", "Severe hepatic impairment"], "adult_dose": "75mg OD; 300–600mg loading", "pediatric_dose": "Not established", "pregnancy_category": "B", "rag_text": "Clopidogrel P2Y12 inhibitor. Combined with aspirin in ACS (dual antiplatelet). Bleeding risk. Generic available in Nepal."},
    {"id": "drug_023", "generic_name": "Warfarin", "generic_name_ne": "वार्फारिन", "category": "Anticoagulant", "nelm_tier": "complementary", "dosage_forms": ["tablet"], "strengths": ["1mg", "2mg", "5mg"], "brand_names": [{"name": "Warf", "manufacturer": "NPL"}, {"name": "Coumadin", "manufacturer": "Bristol-Myers"}], "indications": ["AF", "Mechanical valve", "DVT/PE"], "contraindications": ["Active bleeding", "Pregnancy"], "adult_dose": "Individualized; typical 2–5mg OD; target INR 2–3", "pediatric_dose": "Individualized", "pregnancy_category": "X", "rag_text": "Warfarin requires INR monitoring — challenging in rural Nepal. Many drug and food interactions. Vitamin K in green leafy vegetables affects dose."},
    {"id": "drug_024", "generic_name": "Salbutamol", "generic_name_ne": "सालबुटामोल", "category": "Bronchodilator", "nelm_tier": "core", "dosage_forms": ["inhaler", "nebulizer", "tablet"], "strengths": ["100mcg/puff", "2.5mg/2.5ml", "4mg tablet"], "brand_names": [{"name": "Asthalin", "manufacturer": "Cipla"}, {"name": "Ventolin", "manufacturer": "GSK"}], "indications": ["Asthma", "COPD", "Acute bronchospasm"], "contraindications": ["Tachyarrhythmia (relative)"], "adult_dose": "2 puffs PRN; neb 2.5–5mg q20min x3 in acute", "pediatric_dose": "1–2 puffs or 0.15mg/kg neb", "pregnancy_category": "C", "rag_text": "Salbutamol short-acting beta-agonist rescue inhaler. Teach spacer technique. Tremor and tachycardia common. Household air pollution worsens asthma in Kathmandu valley."},
    {"id": "drug_025", "generic_name": "Beclomethasone", "generic_name_ne": "बेक्लोमेटासोन", "category": "Inhaled corticosteroid", "nelm_tier": "complementary", "dosage_forms": ["inhaler"], "strengths": ["100mcg/puff", "200mcg/puff"], "brand_names": [{"name": "Beclate", "manufacturer": "Cipla"}, {"name": "Qvar", "manufacturer": "Teva"}], "indications": ["Asthma maintenance"], "contraindications": ["Untreated fungal infection"], "adult_dose": "200–400mcg BD", "pediatric_dose": "100–200mcg BD", "pregnancy_category": "C", "rag_text": "ICS controller therapy for asthma. Rinse mouth after use. Not for acute attacks. Combine with salbutamol rescue."},
    {"id": "drug_026", "generic_name": "Rifampicin", "generic_name_ne": "रिफ्याम्पिसिन", "category": "Anti-TB", "nelm_tier": "core", "dosage_forms": ["capsule", "tablet"], "strengths": ["450mg", "600mg", "150mg"], "brand_names": [{"name": "R-Cin", "manufacturer": "Lupin"}, {"name": "Rifadin", "manufacturer": "Sanofi"}], "indications": ["Tuberculosis", "Latent TB (alternative)", "Prophylaxis"], "contraindications": ["Severe hepatic impairment (relative)"], "adult_dose": "10mg/kg OD (max 600mg) as part of DOTS", "pediatric_dose": "10–15mg/kg OD", "pregnancy_category": "C", "rag_text": "Rifampicin cornerstone of Nepal DOTS TB regimen. Orange body fluids. Hepatotoxic — monitor LFTs. Potent CYP inducer — many interactions."},
    {"id": "drug_027", "generic_name": "Isoniazid", "generic_name_ne": "आइसोनियाजाइड", "category": "Anti-TB", "nelm_tier": "core", "dosage_forms": ["tablet"], "strengths": ["300mg", "100mg"], "brand_names": [{"name": "Isonex", "manufacturer": "Lupin"}, {"name": "Nydrazid", "manufacturer": "Squibb"}], "indications": ["Tuberculosis"], "contraindications": ["Active hepatitis", "Previous INH hepatotoxicity"], "adult_dose": "5mg/kg OD (max 300mg) DOTS", "pediatric_dose": "10–15mg/kg OD", "pregnancy_category": "C", "rag_text": "Isoniazid first-line anti-TB. Give pyridoxine 25mg OD to prevent neuropathy. Monitor for hepatitis symptoms."},
    {"id": "drug_028", "generic_name": "Ethambutol", "generic_name_ne": "एथाम्बुटोल", "category": "Anti-TB", "nelm_tier": "core", "dosage_forms": ["tablet"], "strengths": ["400mg", "800mg"], "brand_names": [{"name": "Combutol", "manufacturer": "Lupin"}, {"name": "Myambutol", "manufacturer": "STADA"}], "indications": ["Tuberculosis"], "contraindications": ["Optic neuritis", "Children too young for color vision testing"], "adult_dose": "15mg/kg OD DOTS", "pediatric_dose": "15–20mg/kg OD", "pregnancy_category": "B", "rag_text": "Ethambutol anti-TB. Baseline and monthly visual acuity and color vision. Retrobulbar neuritis reversible if caught early."},
    {"id": "drug_029", "generic_name": "Pyrazinamide", "generic_name_ne": "पाइराजिनामाइड", "category": "Anti-TB", "nelm_tier": "core", "dosage_forms": ["tablet"], "strengths": ["500mg", "750mg"], "brand_names": [{"name": "Zid", "manufacturer": "Lupin"}, {"name": "PZA", "manufacturer": "NPL"}], "indications": ["Tuberculosis (intensive phase)"], "contraindications": ["Severe gout", "Severe hepatic impairment"], "adult_dose": "25–30mg/kg OD (max 2g) intensive phase", "pediatric_dose": "30–40mg/kg OD", "pregnancy_category": "C", "rag_text": "Pyrazinamide intensive phase 2 months. Hyperuricemia common. Hepatotoxicity — part of triple hepatotoxic regimen with INH and RIF."},
    {"id": "drug_030", "generic_name": "Artemether-Lumefantrine", "generic_name_ne": "आर्टेमेटर-लुमेफ्यान्ट्रिन", "category": "Antimalarial", "nelm_tier": "core", "dosage_forms": ["tablet"], "strengths": ["20/120mg", "40/240mg"], "brand_names": [{"name": "Coartem", "manufacturer": "Novartis"}, {"name": "Lumerax", "manufacturer": "Micro Labs"}], "indications": ["Uncomplicated P. falciparum malaria"], "contraindications": ["First trimester (relative)", "Severe malaria"], "adult_dose": "4 tablets BD x3 days (weight-based)", "pediatric_dose": "Weight-based blister pack", "pregnancy_category": "C", "rag_text": "ACT first-line for falciparum malaria in Nepal Terai endemic districts. Take with fatty food. Confirm diagnosis with RDT before treatment."},
    {"id": "drug_031", "generic_name": "Chloroquine", "generic_name_ne": "क्लोरोक्विन", "category": "Antimalarial", "nelm_tier": "complementary", "dosage_forms": ["tablet"], "strengths": ["250mg base", "150mg base"], "brand_names": [{"name": "Lariago", "manufacturer": "ICICI"}, {"name": "Avloclor", "manufacturer": "Sanofi"}], "indications": ["P. vivax malaria", "Prophylaxis (limited)"], "contraindications": ["Retinopathy (long-term)", "Psoriasis (severe)"], "adult_dose": "600mg base then 300mg at 6h, 24h, 48h (vivax)", "pediatric_dose": "10mg base/kg", "pregnancy_category": "C", "rag_text": "Chloroquine for vivax in Nepal. P. falciparum largely resistant — use ACT instead. Combine with primaquine for radical cure of vivax."},
    {"id": "drug_032", "generic_name": "Omeprazole", "generic_name_ne": "ओमेप्राजोल", "category": "PPI", "nelm_tier": "core", "dosage_forms": ["capsule"], "strengths": ["20mg", "40mg"], "brand_names": [{"name": "Omez", "manufacturer": "Dr. Reddy's"}, {"name": "Losec", "manufacturer": "AstraZeneca"}], "indications": ["GERD", "Peptic ulcer", "H. pylori triple therapy"], "contraindications": ["Hypersensitivity"], "adult_dose": "20mg OD before breakfast", "pediatric_dose": "0.7–1.4mg/kg OD", "pregnancy_category": "C", "rag_text": "Omeprazole PPI for dyspepsia and ulcer common in Nepal. Long-term use — magnesium and B12 deficiency risk. Part of H. pylori eradication."},
